{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://leetcode-automation-1ksh.onrender.com/api/$1"
    },
    {
      "source": "/auth/(.*)",
      "destination": "https://leetcode-automation-1ksh.onrender.com/api/v1/auth/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
