#!/bin/sh
# ----------------------------------------------------------------------------
# Maven Wrapper Script for LeetCode Daily Backend (Unix)
# ----------------------------------------------------------------------------
if command -v mvn >/dev/null 2>&1; then
    exec mvn "$@"
fi

for d in "$HOME/.m2/wrapper/dists/apache-maven-"*; do
    for s in "$d"/*; do
        if [ -x "$s/bin/mvn" ]; then
            exec "$s/bin/mvn" "$@"
        fi
    done
done

echo "[ERROR] Maven not found. Please install Maven or run via Docker."
exit 1
