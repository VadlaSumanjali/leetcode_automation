# ==========================================
# LeetCode Daily - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Database Configuration (MySQL 8)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=leetcode_daily
MYSQL_USER=leetcode_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Server Configuration
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string_here
JWT_EXPIRATION_HOURS=24

# Google Gemini AI Integration (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Gmail SMTP Email Delivery
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password

# Daily Problem Delivery Scheduler (Cron syntax)
# Default: 06:00 AM every day
DAILY_EMAIL_CRON=0 0 6 * * *

