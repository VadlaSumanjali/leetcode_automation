# ==========================================
# LeetCode Daily - Environment Variables
# ==========================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Database Configuration (PostgreSQL / Supabase / MySQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.gzfygfioutetfswszcvc
SPRING_DATASOURCE_PASSWORD=your_supabase_database_password

# Server Configuration
SERVER_PORT=8080
CLIENT_ORIGIN=http://localhost:5173,https://leetcode-automation.vercel.app

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_random_string_here
JWT_EXPIRATION_HOURS=24

# Google Gemini AI Integration (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# HTTP-Based Email Delivery via Resend (Required for Render Free Tier - Port 443 HTTPS)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_FROM_EMAIL=LeetCode Daily <onboarding@resend.dev>

# Optional SMTP Email Delivery (Local Development only - Port 587 firewalled on Render free tier)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_address@gmail.com
MAIL_PASSWORD=your_16_character_google_app_password

# Daily Problem Delivery Scheduler (Cron syntax)
# Default: 06:00 AM every day
DAILY_EMAIL_CRON=0 0 6 * * *
